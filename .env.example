# ── Server Configuration (apps/server — deploy to Render/Railway/Fly.io) ──────
PORT=4000
NODE_ENV=development

# Comma-separated allowed CORS origins (no trailing slashes)
# Example for production: CLIENT_ORIGIN=https://your-app.vercel.app,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

MAX_UPLOAD_SIZE_MB=500
FILE_TTL_SECONDS=300
HEARTBEAT_TIMEOUT_SECONDS=30
UPLOAD_DIR=./uploads

# ── Web Configuration (apps/web — deploy to Vercel) ──────────────────────────
# Set this in Vercel dashboard under Environment Variables after deploying the server
# Local dev: point to local server
NEXT_PUBLIC_API_URL=http://localhost:4000
